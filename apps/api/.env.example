# Copy to apps/api/.env and fill in real values. NEVER commit the real .env.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Runtime ---
# "development" (skips Twilio signature validation for local/ngrok testing) or "production".
NODE_ENV=development

# --- Booking provider ---
# "mock" (in-memory, default for development) or "optima"
BOOKING_PROVIDER=mock

# --- Message coalescing (Issue 5: merge rapid messages into one reply) ---
# Quiet gap (ms) after the last message before the agent replies (default 2000).
MESSAGE_DEBOUNCE_MS=
# Hard cap (ms) on total coalescing wait, so many rapid messages still get answered (default 6000).
MESSAGE_MAX_WAIT_MS=

# --- Request guards on /whatsapp (anti-flood + input hardening) ---
# Sliding-window rate limits (in-memory per process). 0 = unlimited for that dimension.
# Max inbound requests per phone per window (default 20).
RATE_LIMIT_PER_PHONE=
# Max inbound requests across ALL phones per window (default 600).
RATE_LIMIT_GLOBAL=
# Window length in ms (default 60000).
RATE_LIMIT_WINDOW_MS=
# Max inbound message length in chars; longer messages are truncated before the model (default 1600).
MAX_MESSAGE_LENGTH=

# --- Twilio (WhatsApp webhook signature validation on /whatsapp) ---
# Auth token from the Twilio console. Required to validate X-Twilio-Signature
# (validation is enforced unless NODE_ENV=development/test).
TWILIO_AUTH_TOKEN=
# Optional: the exact public webhook URL Twilio calls, e.g. https://xxxx.ngrok-free.app/whatsapp
# If unset, it is rebuilt from X-Forwarded-Proto/Host (works behind ngrok).
TWILIO_WEBHOOK_URL=
# Optional: set "true" to enforce signature validation even in development.
FORCE_TWILIO_VALIDATION=

# --- Twilio (outbound WhatsApp — required to SEND staff escalation notifications) ---
# Account SID from the Twilio console (starts with "AC..."); the TWILIO_AUTH_TOKEN above is
# reused as the secret. Without SID + FROM, escalations are still recorded but the staff
# notification is skipped and logged loudly as [escalation-notify-failed].
TWILIO_ACCOUNT_SID=
# WhatsApp-enabled Twilio sender, e.g. whatsapp:+14155238886 (sandbox) or your own number.
TWILIO_WHATSAPP_FROM=

# --- Escalation staff notifications ---
# Staff WhatsApp numbers alerted on escalation (E.164, e.g. +97250...). Routing:
#   medical_symptom       -> ESCALATION_PHONE_MEDICAL
#   all other categories  -> ESCALATION_PHONE_SERVICE
# Either falls back to ESCALATION_PHONE_DEFAULT when its specific number is unset.
# PLACEHOLDERS until the clinic provides real numbers — for the demo, point all at one number.
ESCALATION_PHONE_MEDICAL=
ESCALATION_PHONE_SERVICE=
ESCALATION_PHONE_DEFAULT=

# --- Debug routes ---
# Set "true" ONLY for local debugging (enables /db-test). NEVER set this behind ngrok.
ENABLE_DEBUG_ROUTES=

# --- Optima WS Adapter (per-tenant credentials) ---
# Required for the optima provider and for scripts/test-optima.ts.
# Base URL must include the /api2 prefix, e.g. https://host/api2
OPTIMA_BASE_URL=
OPTIMA_USERNAME=
OPTIMA_PASSWORD=
OPTIMA_COMPANY=
# Optional request timeout in ms (default 20000)
OPTIMA_TIMEOUT_MS=

# --- scripts/test-optima.ts (optional overrides) ---
# Example patient search string and a short ISO date range (YYYY-MM-DD).
OPTIMA_TEST_SEARCH=
OPTIMA_TEST_START=
OPTIMA_TEST_END=
